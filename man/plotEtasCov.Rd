  df = ind_params, 
  covName = "WT", 
  etaNames = c("ETA3", "ETA4"),
  etaTypes = c("EBE", "FREM"),
  etaLabels = c("Clearance", "Volume"),
  typeLabels = c("EBE" = "FFEM EBE", "FREM" = "FREM EBE")
)
print(p_strict)

# 4. Example B: Diagnostic Plot with Missing Data
# Visualizes missing covariates and fits a separate smoothing line for them
p_missing <- plotEtasCov(
  df = ind_params, 
  covName = "WT", 
  etaNames = c("ETA3"),
  etaTypes = c("FREM"),
  showMissing = TRUE,
  smoothMissing = TRUE,
  smoothMissingLinetype = "solid",
  smoothColor = "#005B65"
)
