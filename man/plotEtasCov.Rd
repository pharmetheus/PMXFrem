# 2. Generate the individual ETAs and missingness flags
ind_params <- calcEtas(
  modName            = "run31",
  modDevDir          = model_dir,
  numNonFREMThetas   = 7,
  numSkipOm          = 2,
  dataFile           = my_data,
  parNames           = c("CL", "V", "MAT"),
  ffemModName        = "run31max0",
  appendMissingFlags = TRUE
)

# 3. Example A: Default Diagnostic Plot
