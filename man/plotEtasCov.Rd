# 5. Customized plot restricting to specific ETAs with a linear trend line
p2 <- plotEtasCov(
  df = ind_params, 
  covName = "WT", 
  etaNames = c("ETA3", "ETA4"),
  xlab = "Weight (kg)", 
  ylab = "Empirical Bayes Estimate",
  smoothMethod = "lm", 
  smoothColor = "blue",
  smoothLinetype = "dashed"
)
print(p2)
