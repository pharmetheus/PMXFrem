;; 1. Based on: run202s
;; 2. Description:
;;    Final scm+ model (backward search of scm200), rerun from rounded estimates with $COVARIANCE and $TABLE
;; 3. Label:
;;    final scm+ model, studies 7 and 3
;------------------------------------------------------------------------------
$PROBLEM    run203
$INPUT      ID STUDYID TAD TIME OCC AMT RATE SS II EVID ODV DV DOSE
            FOOD WT HT AGE=DROP RACE=DROP BMI CRCL=DROP NCI SEX ETHNIC
            SMOK=DROP GENO FORM AST ALT BILI NCIORG RACEORG LNWT
$DATA      dataset3-r2.csv IGNORE=@
$SUBROUTINE ADVAN2 TRANS2
$PK
;;; VSEX-DEFINITION START
IF(SEX.EQ.1) VSEX = 1  ; Most common
IF(SEX.EQ.2) VSEX = ( 1 + THETA(10))
;;; VSEX-DEFINITION END


;;; VLNWT-DEFINITION START
   VLNWT = EXP(THETA(9)*(LNWT - 4.5))
;;; VLNWT-DEFINITION END

;;; V-RELATION START
VCOV=VLNWT*VSEX
;;; V-RELATION END


;;; MATFOOD-DEFINITION START
IF(FOOD.EQ.1) MATFOOD = 1  ; Most common
IF(FOOD.EQ.0) MATFOOD = ( 1 + THETA(8))
;;; MATFOOD-DEFINITION END

;;; MAT-RELATION START
MATCOV=MATFOOD
;;; MAT-RELATION END


;;; CLNCI-DEFINITION START
IF(NCI.EQ.0) CLNCI = 1  ; Most common
IF(NCI.EQ.1) CLNCI = ( 1 + THETA(7))
;;; CLNCI-DEFINITION END


;;; CLHT-DEFINITION START
IF(HT.EQ.-99) THEN
   CLHT = 1
ELSE
   CLHT = EXP(THETA(6)*(HT - 170.09))
ENDIF
;;; CLHT-DEFINITION END


;;; CLBMI-DEFINITION START
   CLBMI = EXP(THETA(5)*(BMI - 31.4))
;;; CLBMI-DEFINITION END

;;; CL-RELATION START
CLCOV=CLBMI*CLHT*CLNCI
;;; CL-RELATION END


TVCL    = THETA(1)

TVCL = CLCOV*TVCL
TVV     = THETA(2)

TVV = VCOV*TVV
TVMAT   = THETA(3)

TVMAT = MATCOV*TVMAT
TVD1    = THETA(4)

CL    = TVCL    * EXP(ETA(2))
V     = TVV     * EXP(ETA(3))
MAT   = TVMAT   * EXP(ETA(4))
D1    = MAT*(1-TVD1)

KA    = 1 / (MAT-D1)
S2    = V

$ERROR
CP    = A(2)*1000 / V
IPRED = LOG(CP + 0.00001)
Y     = IPRED + EPS(1) * EXP(ETA(1))

$THETA  (0,7.45) ; 1. TVCL
$THETA  (0,123) ; 2. TVV
$THETA  (0,2) ; 3. TVMAT
$THETA  (0,0.689,1) ; 4. fr D1
$THETA  (-0.206509873811125,0.0141,0.206509873811125) ; CLBMI1
$THETA  (-0.164411645340525,0.00698,0.164411645340525) ; CLHT1
$THETA  (-1,-0.241,5) ; CLNCI1
$THETA  (-1,-0.138,5) ; MATFOOD1
$THETA  (-7.19557841560639,1.01,7.19557841560639) ; VLNWT1
$THETA  (-1,0.389,5) ; VSEX1
$OMEGA  0.0662  ; 1. IIV on RUV
$OMEGA  BLOCK(3)
 0.182  ; 2. IIV on CL
 0.0857 0.149  ; 3. IIV on V
 0.0144 0.0542 0.0441  ; 4. IIV on MAT
$SIGMA  0.0355  ;     1. RUV
$ESTIMATION METHOD=1 INTER MAXEVAL=9999 PRINT=5 NOABORT CTYPE=4
$COVARIANCE PRINT=E UNCONDITIONAL
$TABLE      ID TIME TAD EVID STUDYID DV PRED IPRED CWRES CIWRES CL V MAT
            NOPRINT ONEHEADER FILE=goftab203

