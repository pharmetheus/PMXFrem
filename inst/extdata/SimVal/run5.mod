;; 1. Based on: 4
;; 2. Description:
;;    Adding genotype on CL as a mechanistic covariate
;; 3. Label:
;;    SimVal base model
;------------------------------------------------------------------------------
$PROBLEM    run 5
$INPUT      REF ROWNR ID STUDYIDN TSFDH TIME TSFDNH TSLDH DAY TYPE EVID ODV DV LLOQ BLQ AMT RATE DOSEVN DOSENN TRTN FORMN FOODDN 
            SEXN RACEN RACELN RACEL1N RACEL2N RACEL3N ETHNICHN HTCMBL AGEYBL WTKGBL BMIBL GENON GENO1N GENO2N GENO3N GENO4N SMOK 
            ALTBL ASTBL BILIBL CRCLBL NCIN NCI0N NCI1N NCI2N NCILN ADTM=DROP DATETIME=DROP USUBJID=DROP
$DATA       ../../ProducedData/Dataset/DAT-1b-PMX-REP-PMX-2.csv
            IGNORE=@ IGNORE(TRTN.EQN.2) IGNORE(BLQ.EQN.1)
            IGNORE=(ID.EQN.895)
$SUBROUTINE ADVAN2 TRANS2
$PK
TVFREL  = THETA(1)

CLWT    =  (WTKGBL/75)**THETA(2)
CLGENO1 = 1
CLGENO2 = 1
CLGENO3 = 1
CLGENO4 = 1
IF(GENO1N.EQ.1) CLGENO1 = (1+THETA(8))
IF(GENO3N.EQ.1) CLGENO3 = (1+THETA(9))
IF(GENO4N.EQ.1) CLGENO4 = (1+THETA(10))

CLCOV1 = CLWT*CLGENO1*CLGENO2*CLGENO3*CLGENO4

VWT   = (WTKGBL/75)**THETA(3)
VCOV1  = VWT

TVCL    = THETA(4) * CLCOV1
TVV     = THETA(5) * VCOV1
TVMAT   = THETA(6)
TVD1    = THETA(7)

FREL  = TVFREL  * EXP(ETA(2))
CL    = TVCL    * EXP(ETA(3))
V     = TVV     * EXP(ETA(4))
MAT   = TVMAT   * EXP(ETA(5))
D1    = MAT*(1-TVD1)

F1    = FREL
KA    = 1 / (MAT-D1)
S2    = V

$ERROR
CP    = A(2)*1000 / V
IPRED = LOG(CP + 0.00001)
Y     = IPRED + EPS(1) * EXP(ETA(1))

$THETA  1 FIX ; 1. TVFREL
$THETA  0.75 FIX ; 2. WTKGBL coef on TVCL
$THETA  1 FIX ; 3. WTKGBL coef on TVV
$THETA  (0,12.9322) ; 4. TVCL
$THETA  (0,194.517) ; 5. TVV
$THETA  (0,6.60379) ; 6. TVMAT
$THETA  (0,0.620387,1) ; 7 TVD1
$THETA  (-1,0.01)          ; GENO1N=1 on CL
$THETA  (-1,0.01)          ; GENO3N=1 on CL
$THETA  (-1,0.01)          ; GENO4N=1 on CL
$OMEGA  0.0222044  ; 1. IIV on RUV
$OMEGA  0.408307  ; 2. IIV on FREL
$OMEGA  0.146483  ; 3. IIV on CL
$OMEGA  0.0850437  ; 4. IIV on V
$OMEGA  0.141458  ; 5. IIV on MAT
$SIGMA  0.0487785  ;     1. RUV
$ESTIMATION METHOD=1 INTER ETASTYPE=1 MAXEVAL=9999 PRINT=1 NOABORT
$COVARIANCE PRINT=E MATRIX=S UNCONDITIONAL
$TABLE      REF ID STUDYIDN TSFDH TIME TSFDNH TSLDH DAY TYPE EVID DV LLOQ BLQ AMT RATE DOSEVN DOSENN TRTN FORMN FOODDN 
            SEXN RACEN ETHNICHN HTCMBL AGEYBL WTKGBL BMIBL GENON SMOK ALTBL ASTBL BILIBL CRCLBL GENO1N GENO2N GENO3N GENO4N 
            NCIN NCILN CPRED CIPREDI CWRES CIWRES ETAS(1:LAST)
            NOPRINT ONEHEADER FILE=xptab5

